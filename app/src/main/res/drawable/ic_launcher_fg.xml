<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- bluish glow -->
    <path android:pathData="M8,54 a46,46 0 1,0 92,0 a46,46 0 1,0 -92,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="46">
                <item android:offset="0.0" android:color="#8C96B4EB" />
                <item android:offset="0.55" android:color="#3D96B4EB" />
                <item android:offset="1.0" android:color="#0096B4EB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- moon disc -->
    <path android:pathData="M20,52 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="42"
                android:centerY="44"
                android:gradientRadius="36">
                <item android:offset="0.0" android:color="#FFF4F7FD" />
                <item android:offset="0.58" android:color="#FFC8D3E9" />
                <item android:offset="1.0" android:color="#FF9AA8C8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- carve the crescent (same colour as the icon background) -->
    <path
        android:fillColor="#FF15100D"
        android:pathData="M37,46 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0 Z" />
</vector>
